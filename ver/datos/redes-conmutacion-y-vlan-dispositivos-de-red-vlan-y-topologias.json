{"id": "actividades/redes/conmutacion-y-vlan/dispositivos-de-red-vlan-y-topologias", "preguntas": [{"tipo": "multichoice", "nombre": "Switch o router", "enunciado": "<div style=\"background-color: #ffffff; padding: 12px 14px; border-radius: 6px; border: 1px solid #DCDFE5; font-family: Arial, sans-serif; line-height: 1.6; margin: 6px 0;\">\n<p style=\"margin: 0;\">❓ ¿Qué dispositivo comunica dos redes IP diferentes, por ejemplo, la red local de una oficina con Internet?</p>\n</div>", "retro": "<div style=\"border: 1px solid #DCDFE5; border-radius: 8px; overflow: hidden; font-family: Arial, sans-serif; margin: 12px 0;\">\n<div style=\"background-color: #0c7c59; color: white; padding: 6px 12px; font-weight: 600; font-size: 15px;\">✅ Solución</div>\n<div style=\"background-color: #ffffff; padding: 16px 16px 4px 16px; line-height: 1.6; font-size: 1.05rem; overflow-x: auto;\">\n<div style=\"margin: 0 0 12px 0;\">\n<p style=\"margin: 0 0 6px 0; font-weight: bold; color: #0c7c59;\">💡 Explicación</p>\n<div style=\"margin: 0;\">El <strong>switch de capa 2</strong> reenvía tramas usando direcciones MAC dentro de una red; el <strong>router</strong> examina las direcciones IP de destino y comunica redes IP diferentes.</div>\n</div>\n<div style=\"margin: 0 0 12px 0;\">El router</div>\n</div>\n</div>", "respuestas": [{"texto": "<p>El router</p>", "fraccion": 100.0, "correcta": true, "retro": ""}, {"texto": "<p>El switch de capa 2</p>", "fraccion": 0.0, "correcta": false, "retro": "<p>El switch de capa 2 comunica dispositivos dentro de una misma red local o VLAN.</p>"}, {"texto": "<p>El panel de parcheo</p>", "fraccion": 0.0, "correcta": false, "retro": "<p>Es un elemento pasivo: no procesa ni reenvía tramas.</p>"}, {"texto": "<p>El punto de acceso</p>", "fraccion": 0.0, "correcta": false, "retro": "<p>Proporciona conexión inalámbrica a una red existente.</p>"}], "multiple": false, "fichero": "dispositivos-de-red-vlan-y-topologias.xml"}, {"tipo": "multichoice", "nombre": "Topologías de switches", "enunciado": "<div style=\"background-color: #ffffff; padding: 12px 14px; border-radius: 6px; border: 1px solid #DCDFE5; font-family: Arial, sans-serif; line-height: 1.6; margin: 6px 0;\">\n<p style=\"margin: 0;\">❓ ¿Cómo están conectados estos switches?</p>\n<p style=\"margin: 0px; text-align: center;\"><img class=\"img-fluid\" role=\"presentation\" src=\"@@PLUGINFILE@@/image.png?1793119445502\" alt=\"\" width=\"400\" height=\"251\"></p>\n</div>", "retro": "<div style=\"border: 1px solid #DCDFE5; border-radius: 8px; overflow: hidden; font-family: Arial, sans-serif; margin: 12px 0;\">\n<div style=\"background-color: #0c7c59; color: white; padding: 6px 12px; font-weight: 600; font-size: 15px;\">✅ Solución</div>\n<div style=\"background-color: #ffffff; padding: 16px 16px 4px 16px; line-height: 1.6; font-size: 1.05rem; overflow-x: auto;\">\n<div style=\"margin: 0 0 12px 0;\">\n<p style=\"margin: 0 0 6px 0; font-weight: bold; color: #0c7c59;\">💡 Explicación</p>\n<div style=\"margin: 0;\">En estrella.</div>\n<div style=\"margin: 0px; text-align: center;\"><img class=\"img-fluid\" src=\"@@PLUGINFILE@@/image.png\"></div>\n</div>\n</div>\n</div>", "respuestas": [{"texto": "<p>En anillo.</p>", "fraccion": 0.0, "correcta": false, "retro": ""}, {"texto": "<p>En estrella.</p>", "fraccion": 100.0, "correcta": true, "retro": ""}, {"texto": "<p>En árbol.</p>", "fraccion": 0.0, "correcta": false, "retro": ""}, {"texto": "<p>En cascada.</p>", "fraccion": 0.0, "correcta": false, "retro": ""}], "multiple": false, "fichero": "dispositivos-de-red-vlan-y-topologias.xml"}, {"tipo": "multichoice", "nombre": "VLAN", "enunciado": "<div style=\"background-color: #ffffff; padding: 12px 14px; border-radius: 6px; border: 1px solid #DCDFE5; font-family: Arial, sans-serif; line-height: 1.6; margin: 6px 0;\">\n<p style=\"margin: 0;\">❓ Dos ordenadores están conectados al mismo switch gestionable, pero uno pertenece a la VLAN 10 y el otro a la VLAN 20. ¿Qué afirmación es correcta?</p>\n</div>", "retro": "<div style=\"border: 1px solid #DCDFE5; border-radius: 8px; overflow: hidden; font-family: Arial, sans-serif; margin: 12px 0;\">\n<div style=\"background-color: #0c7c59; color: white; padding: 6px 12px; font-weight: 600; font-size: 15px;\">✅ Solución</div>\n<div style=\"background-color: #ffffff; padding: 16px 16px 4px 16px; line-height: 1.6; font-size: 1.05rem; overflow-x: auto;\">\n<div style=\"margin: 0 0 12px 0;\">\n<p style=\"margin: 0 0 6px 0; font-weight: bold; color: #0c7c59;\">💡 Explicación</p>\n<div style=\"margin: 0;\">Una <strong>VLAN</strong> divide una infraestructura física en varias redes lógicas independientes: un mismo switch puede dar servicio a varias VLAN.</div>\n</div>\n<div style=\"margin: 0 0 12px 0;\">Pertenecen a redes lógicas distintas aunque compartan el mismo switch.</div>\n</div>\n</div>", "respuestas": [{"texto": "<p>Pertenecen a redes lógicas distintas aunque compartan el mismo switch.</p>", "fraccion": 100.0, "correcta": true, "retro": ""}, {"texto": "<p>Como están en el mismo switch, pertenecen a la misma red.</p>", "fraccion": 0.0, "correcta": false, "retro": "<p>Con VLAN, la organización lógica no tiene por qué coincidir con la física.</p>"}, {"texto": "<p>Las VLAN solo funcionan en redes wifi.</p>", "fraccion": 0.0, "correcta": false, "retro": "<p>Las VLAN se configuran en switches gestionables.</p>"}, {"texto": "<p>Para separarlos hay que usar dos switches distintos.</p>", "fraccion": 0.0, "correcta": false, "retro": "<p>Precisamente las VLAN permiten separarlos en un mismo switch.</p>"}], "multiple": false, "fichero": "dispositivos-de-red-vlan-y-topologias.xml"}]}