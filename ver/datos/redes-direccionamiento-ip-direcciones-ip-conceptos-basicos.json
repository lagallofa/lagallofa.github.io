{"id": "actividades/redes/direccionamiento-ip/direcciones-ip-conceptos-basicos", "preguntas": [{"tipo": "multichoice", "nombre": "Direccionamiento IP · Direcciones IP privadas", "enunciado": "<div style=\"background-color: #ffffff; padding: 12px 14px; border-radius: 6px; border: 1px solid #DCDFE5; font-family: Arial, sans-serif; line-height: 1.6; margin: 6px 0;\">\n<p style=\"margin: 0;\">❓ ¿Cuál de estas direcciones IPv4 es <strong>privada</strong>?</p>\n</div>", "retro": "<div style=\"border: 1px solid #DCDFE5; border-radius: 8px; overflow: hidden; font-family: Arial, sans-serif; margin: 12px 0;\">\n<div style=\"background-color: #0c7c59; color: white; padding: 6px 12px; font-weight: 600; font-size: 15px;\">✅ Solución</div>\n<div style=\"background-color: #ffffff; padding: 16px 16px 4px 16px; line-height: 1.6; font-size: 1.05rem; overflow-x: auto;\">\n<div style=\"margin: 0 0 12px 0;\">\n<p style=\"margin: 0 0 6px 0; font-weight: bold; color: #0c7c59;\">💡 Explicación</p>\n<div style=\"margin: 0;\">Los rangos privados son <strong>10.0.0.0/8</strong>, <strong>172.16.0.0/12</strong> (172.16 a 172.31) y <strong>192.168.0.0/16</strong>.</div>\n</div>\n<div style=\"margin: 0 0 12px 0;\">172.20.5.10</div>\n</div>\n</div>", "captura": "actividades/redes/direccionamiento-ip/direcciones-ip-conceptos-basicos/images/direcciones-ip-conceptos-basicos/direccionamiento-ip-direcciones-ip-privadas_1.png", "respuestas": [{"texto": "<p>172.20.5.10</p>", "fraccion": 100.0, "correcta": true, "retro": ""}, {"texto": "<p>8.8.8.8</p>", "fraccion": 0.0, "correcta": false, "retro": "<p>Es una dirección pública.</p>"}, {"texto": "<p>172.32.1.1</p>", "fraccion": 0.0, "correcta": false, "retro": "<p>El rango privado 172.16.0.0/12 llega solo hasta 172.31.255.255.</p>"}, {"texto": "<p>193.168.1.10</p>", "fraccion": 0.0, "correcta": false, "retro": "<p>No confundas con 192.168.x.x: 193.168 no es un rango privado.</p>"}], "multiple": false, "fichero": "direcciones-ip-conceptos-basicos.xml"}, {"tipo": "multichoice", "nombre": "Direccionamiento IP · Puerta de enlace", "enunciado": "<div style=\"background-color: #ffffff; padding: 12px 14px; border-radius: 6px; border: 1px solid #DCDFE5; font-family: Arial, sans-serif; line-height: 1.6; margin: 6px 0;\">\n<p style=\"margin: 0;\">❓ Un ordenador con la dirección 192.168.10.25 quiere acceder a una página web de Internet. ¿A quién envía los paquetes?</p>\n</div>", "retro": "<div style=\"border: 1px solid #DCDFE5; border-radius: 8px; overflow: hidden; font-family: Arial, sans-serif; margin: 12px 0;\">\n<div style=\"background-color: #0c7c59; color: white; padding: 6px 12px; font-weight: 600; font-size: 15px;\">✅ Solución</div>\n<div style=\"background-color: #ffffff; padding: 16px 16px 4px 16px; line-height: 1.6; font-size: 1.05rem; overflow-x: auto;\">\n<div style=\"margin: 0 0 12px 0;\">\n<p style=\"margin: 0 0 6px 0; font-weight: bold; color: #0c7c59;\">💡 Explicación</p>\n<div style=\"margin: 0;\">La <strong>puerta de enlace predeterminada</strong> es el dispositivo de capa 3 (un router o un switch de capa 3) al que el equipo envía los paquetes destinados a otras redes.</div>\n</div>\n<div style=\"margin: 0 0 12px 0;\">A su puerta de enlace predeterminada, normalmente el router.</div>\n</div>\n</div>", "captura": "actividades/redes/direccionamiento-ip/direcciones-ip-conceptos-basicos/images/direcciones-ip-conceptos-basicos/direccionamiento-ip-puerta-de-enlace_1.png", "respuestas": [{"texto": "<p>A su puerta de enlace predeterminada, normalmente el router.</p>", "fraccion": 100.0, "correcta": true, "retro": ""}, {"texto": "<p>Directamente al servidor web, sin pasar por ningún otro dispositivo.</p>", "fraccion": 0.0, "correcta": false, "retro": "<p>El servidor está en otra red: hace falta un dispositivo de capa 3.</p>"}, {"texto": "<p>Al switch de capa 2, que los enruta a Internet.</p>", "fraccion": 0.0, "correcta": false, "retro": "<p>Un switch de capa 2 no comunica redes IP diferentes.</p>"}, {"texto": "<p>A la impresora de red.</p>", "fraccion": 0.0, "correcta": false, "retro": "<p>La impresora no encamina tráfico.</p>"}], "multiple": false, "fichero": "direcciones-ip-conceptos-basicos.xml"}, {"tipo": "cloze", "nombre": "Direccionamiento IP · Qué es una dirección IP", "enunciado": "<div style=\"background-color: #ffffff; padding: 12px 14px; border-radius: 6px; border: 1px solid #DCDFE5; font-family: Arial, sans-serif; line-height: 1.6; margin: 6px 0;\">\n<p style=\"margin: 0 0 10px 0;\">❓ Una <strong>dirección IP</strong> es... <mark class=\"hueco\">un número que identifica a cada dispositivo dentro de una red</mark></p>\n<p>¿Cuál de estas es una dirección <strong>IPv4 válida</strong>? <mark class=\"hueco\">192.168.1.25</mark></p>\n</div>", "retro": "<div style=\"background-color: #ffffff; padding: 12px 14px; border-radius: 6px; border: 1px solid #DCDFE5; font-family: Arial, sans-serif; line-height: 1.6; margin: 6px 0;\">\n<p style=\"margin: 0 0 6px 0; font-weight: bold; color: #0c7c59;\">✅ Feedback</p>\n<p style=\"margin: 0;\">Una IPv4 tiene <strong>4 números separados por puntos</strong>, cada uno entre <strong>0 y 255</strong> (por ejemplo, 192.168.1.25). 192.168.1.256 no vale porque 256 &gt; 255; 10.0.0 solo tiene 3 números; y 00:1A:2B:3C:4D:5E es una <strong>dirección MAC</strong>, no una IP.</p>\n</div>", "captura": "actividades/redes/direccionamiento-ip/direcciones-ip-conceptos-basicos/images/direcciones-ip-conceptos-basicos/direccionamiento-ip-que-es-una-direccion-ip_1.png", "fichero": "direcciones-ip-conceptos-basicos.xml"}]}