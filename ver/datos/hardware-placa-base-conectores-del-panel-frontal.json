{"id": "actividades/hardware/placa-base/conectores-del-panel-frontal", "preguntas": [{"tipo": "ddimageortext", "nombre": "Panel frontal · Arrastrar los conectores y LED de la carcasa", "enunciado": "<div style=\"border: 1px solid #DCDFE5; border-radius: 8px; overflow: hidden; font-family: Arial, sans-serif; background-color: #ffffff; margin: 12px 0;\">\n<div style=\"background-color: #4174c0; color: white; padding: 6px 12px; font-size: 15px; font-weight: 600;\">Panel frontal · Arrastrar los conectores y LED de la carcasa</div>\n<div style=\"padding: 20px; font-size: 1.05rem; line-height: 1.6; overflow-x: auto;\">\n<p>Arrastra donde corresponda. Si no ves bien los led de la carcasa, haz <a href=\"@@PLUGINFILE@@/18638327.jpg\" target=\"_blank\" rel=\"noopener\">clic</a> aquí para una imagen ampliada:</p>\n</div>\n</div>", "retro": "", "captura": "actividades/hardware/placa-base/conectores-del-panel-frontal/images/conectores-del-panel-frontal/panel-frontal-arrastrar-los-conectores-y-led-de-la-carcasa_1.png", "pares": [["(imagen)", "Zona 1"], ["(imagen)", "Zona 2"], ["(imagen)", "Zona 3"], ["(imagen)", "Zona 4"], ["(imagen)", "Zona 5"], ["(imagen)", "Zona 6"], ["(imagen)", "Zona 7"]], "fichero": "conectores-del-panel-frontal.xml"}, {"tipo": "cloze", "nombre": "Panel frontal · Función del conector", "enunciado": "<div style=\"background-color: #ffffff; padding: 12px 14px; border-radius: 6px; border: 1px solid #DCDFE5; font-family: Arial, sans-serif; line-height: 1.6; margin: 6px 0;\">\n<p style=\"margin: 0 0 10px 0;\">❓ Observa el siguiente conector de la parte frontal de la carcasa:</p>\n<table><caption> </caption>\n<thead>\n<tr>\n<th scope=\"col\"><img class=\"img-fluid\" role=\"presentation\" src=\"@@PLUGINFILE@@/conector_delante%20%281%29.jpg\" alt=\"\"></th>\n<th scope=\"col\"><img class=\"img-fluid\" role=\"presentation\" src=\"@@PLUGINFILE@@/Proyecto%20nuevo%20%2839%29.jpg\" alt=\"\"></th>\n</tr>\n</thead>\n</table>\n<p><strong>■ </strong>¿Para qué sirve este conector? <mark class=\"hueco\">Es el botón para controlar la iluminación LED</mark></p>\n</div>", "retro": "<div style=\"background-color: #ffffff; padding: 12px 14px; border-radius: 6px; border: 1px solid #DCDFE5; font-family: Arial, sans-serif; line-height: 1.6; margin: 6px 0;\">\n<p style=\"margin: 0 0 6px 0; font-weight: bold; color: #0c7c59;\">✅ Feedback</p>\n<p style=\"margin: 0;\">Es el conector del botón que controla la iluminación LED o RGB de la caja: lo dice su etiqueta, <strong>LED/RGB SW</strong> (SW = <em>switch</em>, interruptor). Como es un interruptor, no tiene polo positivo ni negativo: se puede conectar en cualquier sentido.</p>\n</div>", "fichero": "conectores-del-panel-frontal.xml"}, {"tipo": "matching", "nombre": "Panel frontal · Relacionar conectores con su función", "enunciado": "<div style=\"background-color: #ffffff; padding: 12px 14px; border-radius: 6px; border: 1px solid #DCDFE5; font-family: Arial, sans-serif; line-height: 1.6; margin: 6px 0;\">\n<p style=\"margin: 0;\">❓ Relaciona cada conector del panel frontal de la carcasa con su función:</p>\n</div>", "retro": "<div style=\"background-color: #ffffff; padding: 12px 14px; border-radius: 6px; border: 1px solid #DCDFE5; font-family: Arial, sans-serif; line-height: 1.6; margin: 6px 0;\">\n<p style=\"margin: 0 0 6px 0; font-weight: bold; color: #0c7c59;\">✅ Feedback</p>\n<p style=\"margin: 0;\">Los cables del panel frontal se conectan al conector <strong>Panel frontal</strong> de la placa base: los <strong>SW</strong> son interruptores (no tienen polaridad) y los <strong>LED</strong> son luces (sí tienen polo positivo y negativo). El audio frontal va aparte, al conector <strong>Audio frontal</strong>.</p>\n</div>", "pares": [["<p>POWER SW</p>", "Botón de encendido del equipo"], ["<p>RESET SW</p>", "Botón que reinicia el equipo"], ["<p>POWER LED</p>", "Luz que indica que el equipo está encendido"], ["<p>HDD LED</p>", "Luz que parpadea cuando hay actividad en el disco"], ["<p>HD AUDIO</p>", "Jacks frontales de auriculares y micrófono"]], "fichero": "conectores-del-panel-frontal.xml"}, {"tipo": "multichoice", "nombre": "Panel frontal · ¿Qué conector corresponde al botón?", "enunciado": "<div style=\"background-color: #ffffff; padding: 12px 14px; border-radius: 6px; border: 1px solid #DCDFE5; font-family: Arial, sans-serif; line-height: 1.6; margin: 6px 0;\">\n<p style=\"margin: 0;\">❓ ¿Cuál de los conectores se corresponde con el botón señalado en la imagen?<br><img class=\"img-fluid\" role=\"presentation\" src=\"@@PLUGINFILE@@/frontal_carcasa.png\" alt=\"\"></p>\n</div>", "retro": "", "captura": "actividades/hardware/placa-base/conectores-del-panel-frontal/images/conectores-del-panel-frontal/panel-frontal-que-conector-corresponde-al-boton_1.png", "respuestas": [{"texto": "<p dir=\"ltr\" style=\"text-align: left;\"><img class=\"img-fluid\" role=\"presentation\" src=\"@@PLUGINFILE@@/hdd_led%20%281%29.jpg\" alt=\"\"></p>", "fraccion": 0.0, "correcta": false, "retro": ""}, {"texto": "<p dir=\"ltr\" style=\"text-align: left;\"><img class=\"img-fluid\" role=\"presentation\" src=\"@@PLUGINFILE@@/power_led%20%282%29.jpg\" alt=\"\"></p>", "fraccion": 0.0, "correcta": false, "retro": ""}, {"texto": "<p dir=\"ltr\" style=\"text-align: left;\"><img class=\"img-fluid\" role=\"presentation\" src=\"@@PLUGINFILE@@/power_sw%20%282%29.jpg\" alt=\"\"></p>", "fraccion": 100.0, "correcta": true, "retro": ""}, {"texto": "<p dir=\"ltr\" style=\"text-align: left;\"><img class=\"img-fluid\" role=\"presentation\" src=\"@@PLUGINFILE@@/usb.jpg\" alt=\"\"></p>", "fraccion": 0.0, "correcta": false, "retro": ""}, {"texto": "<p dir=\"ltr\" style=\"text-align: left;\"><img class=\"img-fluid\" role=\"presentation\" src=\"@@PLUGINFILE@@/audio.jpg\" alt=\"\"></p>", "fraccion": 0.0, "correcta": false, "retro": ""}, {"texto": "<p dir=\"ltr\" style=\"text-align: left;\"><img class=\"img-fluid\" role=\"presentation\" src=\"@@PLUGINFILE@@/usb_b.jpg\" alt=\"\"></p>", "fraccion": 0.0, "correcta": false, "retro": ""}, {"texto": "<p dir=\"ltr\" style=\"text-align: left;\"><img class=\"img-fluid\" role=\"presentation\" src=\"@@PLUGINFILE@@/reset_sw%20%281%29%20%281%29.jpg\" alt=\"\"></p>", "fraccion": 0.0, "correcta": false, "retro": ""}], "multiple": false, "fichero": "conectores-del-panel-frontal.xml"}, {"tipo": "shortanswer", "nombre": "Panel frontal · ¿Qué conector es? (USB)", "enunciado": "<div style=\"background-color: #ffffff; padding: 12px 14px; border-radius: 6px; border: 1px solid #DCDFE5; font-family: Arial, sans-serif; line-height: 1.6; margin: 6px 0;\">\n<p style=\"margin: 0 0 10px 0;\">❓ ¿Qué conector es el mostrado en la imagen?</p>\n<p dir=\"ltr\" style=\"text-align: left;\"><img class=\"img-fluid\" role=\"presentation\" src=\"@@PLUGINFILE@@/image.png\" alt=\"\"></p>\n</div>", "retro": "<div style=\"background-color: #ffffff; padding: 12px 14px; border-radius: 6px; border: 1px solid #DCDFE5; font-family: Arial, sans-serif; line-height: 1.6; margin: 6px 0;\">\n<p style=\"margin: 0 0 6px 0; font-weight: bold; color: #0c7c59;\">✅ Feedback</p>\n<p style=\"margin: 0;\">La respuesta correcta es: <strong>el conector USB</strong>.</p>\n</div>", "captura": "actividades/hardware/placa-base/conectores-del-panel-frontal/images/conectores-del-panel-frontal/panel-frontal-que-conector-es-usb_1.png", "respuestas": [{"texto": "*USB*", "fraccion": 100.0, "correcta": true, "retro": ""}], "multiple": false, "fichero": "conectores-del-panel-frontal.xml"}]}