<!-- question: 151705024  -->
  <question type="cloze">
    <name>
      <text>Unidades · Capacidad en bytes y velocidad en bits</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<div style="background-color: #ffffff; padding: 12px 14px; border-radius: 6px; border: 1px solid #DCDFE5; font-family: Arial, sans-serif; line-height: 1.6; margin: 6px 0;">
<p style="margin: 0 0 10px 0;">❓ Rellena los siguientes huecos con la palabra correcta:</p>
<div class="editor-indent" style="margin-left: 30px;">
<p>■ La capacidad de almacenamiento (de un disco, de la RAM, de un pendrive…) se mide en {1:MC:bits~=bytes}.</p>
<p>■ La velocidad de transmisión (de una conexión a Internet, de una red…) se mide en {1:MC:=bits~bytes} por segundo.</p>
</div>
</div>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<div style="background-color: #ffffff; padding: 12px 14px; border-radius: 6px; border: 1px solid #DCDFE5; font-family: Arial, sans-serif; line-height: 1.6; margin: 6px 0;">
<p style="margin: 0 0 6px 0; font-weight: bold; color: #0c7c59;">✅ Feedback</p>
<p>La respuesta correcta es:</p>
<p>■ La capacidad de almacenamiento se mide en <strong>bytes</strong> (kilobytes, megabytes, gigabytes…).</p>
<p style="margin: 0;">■ La velocidad de transmisión se mide en <strong>bits</strong> por segundo (kbps, Mbps, Gbps…).</p>
</div>]]></text>
    </generalfeedback>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
  </question>

