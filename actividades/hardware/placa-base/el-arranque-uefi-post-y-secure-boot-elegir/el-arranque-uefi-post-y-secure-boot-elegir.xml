    <questiontext format="html">
      <text><![CDATA[<div style="background-color: #ffffff; padding: 12px 14px; border-radius: 6px; border: 1px solid #DCDFE5; font-family: Arial, sans-serif; line-height: 1.6; margin: 6px 0;">
<p style="margin: 0;">❓ Ordena los pasos que sigue un ordenador desde que lo encendemos hasta que se carga el sistema operativo. Arrastra cada paso a su posición, del <strong>primero</strong> (arriba) al <strong>último</strong> (abajo).</p>
</div>]]></text>
    </questiontext>
    <generalfeedback format="html">
