<!-- question: 151703817  -->
  <question type="multichoice">
    <name>
      <text>Comunicación · Tipos de comunicación</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<div style="background-color: #ffffff; padding: 12px 14px; border-radius: 6px; border: 1px solid #DCDFE5; font-family: Arial, sans-serif; line-height: 1.6; margin: 6px 0;">
<p style="margin: 0;">❓ Con un walkie-talkie, las dos personas pueden hablar, pero no a la vez. ¿Qué tipo de comunicación es?</p>
</div>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<div style="border: 1px solid #DCDFE5; border-radius: 8px; overflow: hidden; font-family: Arial, sans-serif; margin: 12px 0;">
<div style="background-color: #0c7c59; color: white; padding: 6px 12px; font-weight: 600; font-size: 15px;">✅ Solución</div>
<div style="background-color: #ffffff; padding: 16px 16px 4px 16px; line-height: 1.6; font-size: 1.05rem; overflow-x: auto;">
<div style="margin: 0 0 12px 0;">
<p style="margin: 0 0 6px 0; font-weight: bold; color: #0c7c59;">💡 Explicación</p>
<div style="margin: 0;"><strong>Símplex</strong>: un solo sentido. <strong>Semidúplex</strong>: los dos sentidos, pero no a la vez. <strong>Dúplex completo</strong>: los dos sentidos a la vez.</div>
</div>
<div style="margin: 0 0 12px 0;">Semidúplex (half-duplex)</div>
</div>
</div>]]></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.0000000</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>1</showstandardinstruction>
    <correctfeedback format="html">
      <text></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text></text>
    </incorrectfeedback>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>Semidúplex (half-duplex)</p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Símplex</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>En símplex la información viaja en un único sentido, como una emisión de radio.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Dúplex completo (full-duplex)</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>En full-duplex ambos transmiten a la vez, como en una llamada telefónica.</p>]]></text>
      </feedback>
    </answer>
  </question>

