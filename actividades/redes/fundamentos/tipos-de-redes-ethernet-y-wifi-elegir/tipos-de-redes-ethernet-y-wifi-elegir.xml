<!-- question: 151703761  -->
  <question type="cloze">
    <name>
      <text>Ethernet y wifi · Ethernet o wifi para jugar</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<div style="background-color: #ffffff; padding: 12px 14px; border-radius: 6px; border: 1px solid #DCDFE5; font-family: Arial, sans-serif; line-height: 1.6; margin: 6px 0;">
<p style="margin: 0;">❓ Si fueras <em><strong>gamer</strong></em>, ¿cómo conectarías tu PC? {1:MC:=Por cable Ethernet~Por wifi}</p>
<p style="margin: 8px 0 0 0;">¿Por qué? {1:MC:=Porque ofrece menor latencia y una conexión más estable~Porque el cable siempre es más barato~Porque el wifi no permite conectarse a Internet~Porque el cable no necesita tarjeta de red}</p>
</div>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<div style="border: 1px solid #DCDFE5; border-radius: 8px; overflow: hidden; font-family: Arial, sans-serif; margin: 12px 0;">
<div style="background-color: #0c7c59; color: white; padding: 6px 12px; font-weight: 600; font-size: 15px;">✅ Solución</div>
<div style="background-color: #ffffff; padding: 16px 16px 4px 16px; line-height: 1.6; font-size: 1.05rem; overflow-x: auto;">
<div style="margin: 0 0 12px 0;">
<p style="margin: 0 0 6px 0; font-weight: bold; color: #0c7c59;">💡 Explicación</p>
<div style="margin: 0;"><strong>Ethernet</strong> ofrece conexiones más estables, con menor latencia y menos interferencias. El wifi da movilidad, pero su rendimiento depende de la distancia, los obstáculos y las interferencias.</div>
</div>
<div style="margin: 0 0 12px 0;">Por cable Ethernet, porque ofrece menor latencia y una conexión más estable</div>
</div>
</div>]]></text>
    </generalfeedback>
    <penalty>0.0000000</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
  </question>

